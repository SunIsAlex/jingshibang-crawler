# OpenAI-compatible multimodal API. Never commit real values.
API_KEY=
API_URL=https://api.example.com/v1

VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
VISION_PROMPT_VERSION=v1
VISION_DISABLE_THINKING=true
VISION_THINKING_PARAM_MODE=auto
MAX_VISION_REQUESTS_PER_RUN=100
MAX_VISION_IMAGES_PER_RUN=200

MAX_DOWNLOADS_PER_DAY=0
REQUEST_CONCURRENCY=1
REQUEST_DELAY_MIN_MS=800
REQUEST_DELAY_MAX_MS=1500
REQUEST_RETRIES=2

HEADLESS=true
BROWSER_CHANNEL=chrome
BROWSER_TIMEOUT_MS=60000
AUTH_STATE_PATH=.local/auth-state.json
DATABASE_PATH=data/jingshibang.db
LOG_LEVEL=info
